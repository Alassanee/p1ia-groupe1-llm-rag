# Copier ce fichier en .env puis remplir sa propre clé (ne jamais commiter .env)
# Choisir UN fournisseur LLM gratuit :

# Option 1 — Groq (https://console.groq.com)
GROQ_API_KEY=

# Option 2 — Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modèle LLM Groq (voir la liste à jour : https://console.groq.com/docs/models)
# Alternatives dispo : openai/gpt-oss-120b (plus gros), qwen/qwen3.8-27b
LLM_MODEL=openai/gpt-oss-20b
